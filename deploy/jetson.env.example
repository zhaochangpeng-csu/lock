# Jetson Nano environment for the smart lock hardware project.
# Copy to .env on the Jetson and fill in real values there.

# Keep hardware unlock disabled until the relay and lock are supervised.
SMART_LOCK_NO_UNLOCK=1
LOCK_AUTH_CONTEXT_PATH=logs/auth_context.json

# FastGPT application API endpoint and key.
# Use the LAN IP/host of the machine running FastGPT.
FASTGPT_API_BASE=http://192.168.1.100:3300
FASTGPT_APP_API_KEY=replace-with-fastgpt-app-api-key
FASTGPT_APP_ID=replace-with-fastgpt-app-id

# Jetson HTTP tool gateway bind address and port.
LOCK_TOOL_GATEWAY_HOST=0.0.0.0
LOCK_TOOL_GATEWAY_PORT=8787

# Shared secret required by Jetson HTTP tool gateway.
LOCK_TOOL_TOKEN=replace-with-long-random-token
LOCK_TOOL_CALL_LOG=logs/tool_gateway_calls.jsonl

# Optional notification placeholders. Workbuddy/QQ/WeChat are deferred.
NOTIFY_OWNER_BACKEND=mock
NOTIFY_OWNER_WEBHOOK=
