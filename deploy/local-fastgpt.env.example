# Local PC/server environment for FastGPT + DeepSeek.
# FastGPT itself stores most settings in its web UI or docker env.

# DeepSeek model provider key configured in FastGPT/AIProxy.
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Jetson tool gateway visible from the FastGPT host/container.
# Change the IP and port to match deploy/jetson.env.example.
# For Jetson LAN deployment, use http://<jetson-lan-ip>:8787.
JETSON_TOOL_BASE=http://172.18.0.1:8787
LOCK_TOOL_TOKEN=must-match-jetson-token

# FastGPT web UI defaults depend on the official compose template.
FASTGPT_WEB_URL=http://localhost:3300

# Optional local port overrides when 3000/3003/3006 are occupied.
# If these values are used, keep the URLs aligned with the ports.
FASTGPT_HTTP_PORT=3300
FASTGPT_MCP_PORT=3303
FASTGPT_SANDBOX_PORT=3316
FASTGPT_MINIO_PORT=3390
FASTGPT_MINIO_CONSOLE_PORT=3391
FASTGPT_FE_DOMAIN=http://localhost:3300
FASTGPT_MCP_ENDPOINT=http://host.docker.internal:3303
FASTGPT_SANDBOX_PROXY_URL=ws://localhost:3316
FASTGPT_SANDBOX_PREVIEW_PROXY_URL=http://localhost:3316
